# Sao chép thành .env rồi điền giá trị thật (file .env đã bị .gitignore).
# Dùng publishable key (sb_publishable_...). KHÔNG dùng secret key / mật khẩu DB.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_publishable_...

# Tuỳ chọn: khoảng thời gian phân tích giá hằng ngày (mặc định hệ thống tự động cập nhật theo ngày mới nhất trong dữ liệu).
# Có thể khai báo nếu muốn giới hạn một khoảng thời gian cụ thể:
# DAILY_FROM=2026-10-18
# DAILY_TO=2026-11-22

# Tuỳ chọn: bổ sung chuỗi theo ngày từ CSV đã làm sạch khi CSV có nhiều ngày hơn Supabase
# DAILY_CSV=C:\duong\dan\02_process_raw_data\daily_price\daily_price_history.csv
